# Copy to .env and fill in. Never commit .env.

# --- infra (docker compose) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market_pulse
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://pulse:change-me@127.0.0.1:5432/market_pulse

# --- analytics ---
MP_RISK_FREE_RATE=0.065
MP_DEFAULT_SYMBOL=NSE:BANKNIFTY

# --- data provider: replay | kite | upstox | fyers (live adapter arrives in Phase 7) ---
MP_PROVIDER=replay
MP_REPLAY_DIR=data/replay/synthetic/BANKNIFTY

# --- later phases ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
