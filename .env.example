# Copy to .env and fill in. Never commit .env.

# --- infra (docker compose) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market_pulse
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://pulse:change-me@127.0.0.1:5432/market_pulse

# --- analytics ---
MP_RISK_FREE_RATE=0.065
MP_DEFAULT_SYMBOL=NSE:BANKNIFTY

# --- data provider: replay (synthetic/recorded) | upstox | kite (live) ---
MP_PROVIDER=replay
MP_REPLAY_DIR=data/replay/synthetic/BANKNIFTY

# --- Upstox (MP_PROVIDER=upstox). App credentials from the Upstox developer console;
# the access token expires daily: get a fresh one with `uv run mp upstox-login`.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/
UPSTOX_ACCESS_TOKEN=

# --- Zerodha Kite Connect (MP_PROVIDER=kite). api_key/secret from developers.kite.trade
# (redirect URL http://127.0.0.1:8000/). The access token expires ~6 AM IST daily:
# get a fresh one with `uv run mp kite-login`. Never commit or share the secret.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- TLS behind a corporate proxy that re-signs HTTPS (verification is never disabled):
# MP_CA_BUNDLE=path/to/corporate-root.pem   or   MP_TLS_TRUSTSTORE=true (use the Windows store)
MP_CA_BUNDLE=
MP_TLS_TRUSTSTORE=

# --- extra host names the dashboard/MCP servers answer to (default: 127.0.0.1, localhost only),
# e.g. a Tailscale name. Ports must also be published beyond 127.0.0.1 for this to matter.
MP_ALLOWED_HOSTS=

# --- Claude: news classification (Haiku) and Ask-Claude (Sonnet) ---
ANTHROPIC_API_KEY=
MP_ASK_EFFORT=low

# --- Telegram alerts (dry run until both are set). Synthetic data never alerts unless allowed. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MP_ALERTS_SYNTHETIC=false
